# Copy to .env and fill in real values. Never commit .env.
# See README.md "Environment variables" for what each one does.

# Postgres connection string used by Prisma when running local host-side
# tooling (`prisma migrate`, `prisma db seed`, `next dev`). Port 5433, not
# 5432 — see docker-compose.yml's comment on the postgres service's ports.
# Inside Docker, the `app` container instead uses `postgres:5432` (the
# internal Docker network), set directly in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/loopnow_cpa"

# Anthropic API key for the agent loop. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Model id the agent uses. Kept as an env var (not hardcoded) so a model
# migration is a config change, not a code change.
ANTHROPIC_MODEL="claude-sonnet-5"
